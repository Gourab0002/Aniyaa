<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Catalog defaults are HTTPS. User-entered mirrors may be HTTP. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
